# Bundled & Local Python Virtual Environments
.python/
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.dll

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.hypothesis/

# Streamlit Local Cache & Credentials
.streamlit/secrets.toml

# Environment Variables, Secrets & Sensitive Files
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
client_secrets.json
secrets/
token.json

# Local Workspace, IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs & Temporary Files
*.log
*.tmp
*.bak
.system_generated/
